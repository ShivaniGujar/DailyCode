import java.util.*;
class Solution{
public boolean answer(int num){
int original=num;
int sum=0;
	for(int i=1;i<num;i++){
	if(num %i==0){
	sum=sum+i;
	}
	}

	return sum==original;
	
	}
}

class DailyPractice{

	public static void main(String args[]){
	Scanner sc=new Scanner(System.in);
	int num=sc.nextInt();
	
	

	Solution dp=new Solution();
	boolean result=dp.answer(num);
	if(result){
	System.out.println("Perfect Number");
}else{
	
	System.out.println("Not Perfect Number");

	}
	
	

	}
}	
