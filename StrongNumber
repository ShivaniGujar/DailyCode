import java.util.*;
class Solution{
public boolean answer(int num){
	int original=num;
	int sum=0;
	while(num>0){
		int digit=num% 10;
		int fact=1;
		for(int i=1;i<=digit;i++){
		fact=fact*i;
		}
	sum=sum+fact;
	num=num/10;
	}
	return sum==original;
}
}

class StrongNumber{

	public static void main(String args[]){
	Scanner sc=new Scanner(System.in);
	int num=sc.nextInt();
	
	

	Solution dp=new Solution();
	boolean result=dp.answer(num);
	if(result){
	System.out.println("Strong Number");
}else{
	
	System.out.println("Not Strong Number");

	}
	
	

	}
}	
