import java.util.*;
class Solution{

public static boolean answer(int num){
	//handle all negative no also 
	if(num<2){
	return false;
	}
	
	for(int i=2;i<=num/i;i++){	
	 if(num %i==0){
		return false;
	}
	}
	return true;	
	
}

}

