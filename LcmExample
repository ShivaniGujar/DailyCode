import java.util.*;
class Solution{
public static int gcdFind(int n1,int n2){
	int candidate=Math.max(n1,n2);
	while(true){
	if(candidate %n1 ==0 && candidate % n2==0){
	return candidate;
//break;	
	
}
	candidate++;
	}
//System.out.println("Least Common multiplier of "+n1+" and "+n2+" is "+candidate);	

 
	
	}



}

